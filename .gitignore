# ── Secrets and personal data ────────────────────────────────────────────────
# Every .env variant, backups included (`.env` alone matches only that name,
# so config/.env.bak used to be committable). config/env.template is the
# tracked, placeholder-only template.
.env
.env.*
*.env
*.env.bak
config/.env*
*.bak
# The applicant profile holds phone, address, salary and EEO answers. It was
# tracked; `git rm --cached` keeps the local file and stops tracking it.
config/applicant_profile.json
# per-tenant Workday logins (plaintext, local only)
config/workday_accounts.json

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__
venv
.venv
backend/venv/

# ── Databases ────────────────────────────────────────────────────────────────
*.db
*.sqlite
backend/db/*.db
backend/db/*.sqlite
.dashboard/dashboard.db
.dashboard/dashboard.sqlite

# ── Runtime data: screenshots of filled forms, browser sessions, cookies ─────
data/*
!data/apply_logs/
data/apply_logs/*
!data/apply_logs/.gitkeep

# ── Resumes: only the master .tex is tracked ─────────────────────────────────
resumes/*.pdf
resumes/*.doc
resumes/*.docx
resumes/tailored/
resumes/archive/

# ── Tooling and temporary files ──────────────────────────────────────────────
tools/
temp/*
temp/**
logs/*
logs/**
backend/resume/testdata/*.pdf
backend/resume/testdata/*.log
